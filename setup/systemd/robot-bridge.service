[Unit]
Description=Muto RS robot_bridge.py — Flask/HTTP bridge naar STM32-serieel
Documentation=file:///home/pi/muto_inventarisatie.md
After=network.target
# LET OP: nooit gelijktijdig met muto_driver_fixed.py -- beide gebruiken
# exclusief /dev/myserial. app_muto.py hoeft niet handmatig gestopt te worden:
# robot_bridge.py doet dit sinds 9 aug 2026 zelf bij het opstarten (zie
# _stop_app_muto() onderaan het bestand) -- app_muto.py's autostart blijft
# bewust actief (~/.config/autostart/app.desktop), zodat na een koude start
# altijd meteen met de gamepad bestuurd kan worden zonder iets te hoeven doen.

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
ExecStart=/usr/bin/python3 /home/pi/robot_bridge.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
